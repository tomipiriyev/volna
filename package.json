{
  "name": "volna",
  "private": true,
  "version": "0.1.0",
  "description": "Volna Antenna Simulation: browser-based FDTD antenna simulator (STEP import, C++/WebAssembly solver, WebGPU rendering)",
  "license": "MIT",
  "repository": "github:tomipiriyev/volna",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/vendor-occt.mjs",
    "predev": "node scripts/vendor-occt.mjs",
    "prebuild": "node scripts/vendor-occt.mjs",
    "prebuild:pages": "node scripts/vendor-occt.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview": "vite preview",
    "preview:noiso": "vite preview --mode noiso --port 4174",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && npm run build:pages && playwright test",
    "wasm": "./scripts/build-wasm.sh",
    "native": "cd cpp && cmake --preset native-release && cmake --build --preset native-release && ctest --preset native-release"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "occt-import-js": "^0.0.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
